# Copier en .env sur le serveur (/opt/souverainrecrut/.env, droits 600).
# Le .env réel n'est jamais versionné ; en CI il est généré à partir des
# variables protégées de GitLab.

# Image publiée par Jenkins sur Docker Hub (tag = <version>-<sha7>)
BACKEND_IMAGE=iamkrugs/souverainrecrut-backend
BACKEND_TAG=1.0.0-7fa9454

# Base de données (mot de passe hexadécimal : sûr dans une URL de connexion)
POSTGRES_DB=souverainrecrut
POSTGRES_USER=souverainrecrut
POSTGRES_PASSWORD=a_remplacer_par_openssl_rand_hex_24

# Clé de signature des tokens JWT
JWT_SECRET=a_remplacer_par_openssl_rand_hex_32

# Origine autorisée par CORS
FRONTEND_URL=https://tanguydavid.fr
